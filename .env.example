COMPOSE_PROJECT_NAME=yii-dev
APP_UID=1000
APP_GID=1000

# Production gets YII_ENV=prod and YII_DEBUG=0. Both are read by the entry
# scripts (app/web/index.php, app/yii); without them the app runs as production.
YII_ENV=dev
YII_DEBUG=1

# Secret that signs the session and CSRF cookies (app/config/web.php).
# Generate it: php -r "echo bin2hex(random_bytes(32));"
COOKIE_VALIDATION_KEY=

POSTGRES_DB=yii_dev
POSTGRES_USER=yii
POSTGRES_PASSWORD=change-me-now

# Forum parser schedule (cron format, container time is UTC)
PARSER_CRON_SCHEDULE=*/10 * * * *

# Telegram bot for the TRVL channel (create via @BotFather, then add as channel admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@gsu_travels

# How often the queue of due publications is drained (cron format, container time is UTC).
# The settings page reads it and refuses a gap between the parts of one
# publication shorter than this interval.
TELEGRAM_PUBLISH_CRON_SCHEDULE=*/5 * * * *
